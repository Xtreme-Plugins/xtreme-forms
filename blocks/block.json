{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "xtreme-forms/form",
	"version": "1.0.0",
	"title": "Xtreme Forms Form",
	"category": "xtreme-forms",
	"description": "Embed a lead capture form on any page, post, or Full Site Editing template.",
	"keywords": ["lead", "form", "contact", "capture"],
	"textdomain": "xtreme-forms",
	"attributes": {
		"formId": {
			"type": "number",
			"default": 0
		},
		"width": {
			"type": "string",
			"default": "100%"
		},
		"alignment": {
			"type": "string",
			"default": "left"
		},
		"backgroundColor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"color": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalLayout": true,
		"__experimentalBorder": {
			"radius": true,
			"width": true
		}
	},
	"example": {
		"attributes": {
			"formId": 0,
			"width": "100%",
			"alignment": "center"
		}
	},
	"editorScript": "xf-form-block"
}
